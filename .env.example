# ==============================================================================
# Zero-Trust RAG Security Platform - Environment Configuration Template
# Copy to '.env' and adjust values for your local or container deployment.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
API_TITLE=Zero-Trust RAG Security Platform
API_VERSION=0.1.0

# Storage Paths (Local or Container Mounts)
# Defaults to project-root /data/storage
DATA_DIR=data
STORAGE_DIR=data/storage
SQLITE_PATH=data/storage/authoritative_metadata.db
VECTOR_STORE_PATH=data/storage/vector_store

# Vector Store Selection
# Options: 'chroma' (persistent SQLite/HNSW) or 'memory' (ephemeral numpy)
VECTOR_STORE_TYPE=chroma

# Embedding Model Selection
# 'true'  = MockDeterministicEmbeddingEngine (zero model download, 100% offline & reproducible)
# 'false' = SentenceTransformerEmbeddingEngine (downloads sentence-transformers/all-MiniLM-L6-v2)
USE_MOCK_EMBEDDINGS=true
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Ingestion Document Guardrails
MAX_DOCUMENT_BYTES=5242880
MAX_DOCUMENT_CHARACTERS=500000
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
